    {
      "name": "Login User",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// La rotta POST /admin/user/login risponde con res.success(token),",
              "// quindi il JWT si trova in response.data come stringa semplice (non",
              "// dentro un oggetto). Se il login va a buon fine lo salviamo come",
              "// collection variable \"token\": tutte le richieste protette di questa",
              "// collection lo leggono già via {{token}} nell'auth Bearer, quindi da",
              "// qui in poi non serve più copiarlo e incollarlo a mano.",
              "const response = pm.response.json();",
              "",
              "if (pm.response.code === 200 && response.success && response.data) {",
              "    pm.collectionVariables.set('token', response.data);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"master@example.com\",\n    \"password\": \"password123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "localhost:5001/admin/user/login",
          "host": [
            "localhost"
          ],
          "port": "5001",
          "path": [
            "admin",
            "user",
            "login"
          ]
        }
      },
      "response": []
    },
