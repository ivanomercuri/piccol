PORT=5000
BACKEND_HOST_PORT=5001
BACKEND_DEBUG_PORT=9229
DB_HOST_PORT=5432
ADMINER_HOST_PORT=8080
FRONTEND_HOST_PORT=3000
DB_ROOT_PASSWORD=rootpassword
DB_USER=postgres
DB_NAME=mydatabase
JWT_SECRET=JWT_SECRET
JWT_EXPIRES_IN=1h
SHOW_ROUTES=true
# In MB. I commenti vanno su una riga propria: il parser env_file di Docker
# Compose NON riconosce un commento in linea senza uno spazio prima del `#`,
# quindi `MAX_FILE_SIZE=3# in MB` arrivava al container come "3# in MB".
MAX_FILE_SIZE=3
# In MB. Oggi non letta dal codice: il limite hard è scritto a mano in
# uploadMiddleware.ts.
MAX_FILE_HARD_SIZE=10
