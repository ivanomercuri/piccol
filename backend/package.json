{
  "name": "express-backend",
  "version": "1.0.0",
  "engines": {
    "node": ">=24.9"
  },
  "scripts": {
    "dev": "nest start --watch --debug 0.0.0.0:9229",
    "build": "nest build",
    "start": "node dist/main",
    "pretest": "NODE_ENV=test prisma db push --accept-data-loss",
    "test": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest",
    "lint": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "seed": "ts-node prisma/seed.ts",
    "seed:dev": "ts-node prisma/seed-dev.ts",
    "migrate": "prisma migrate deploy",
    "generate": "DB_USER=local DB_ROOT_PASSWORD=local DB_HOST=local DB_NAME=local prisma generate"
  },
  "imports": {
    "#image-config": "./config/imageConfig.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "image-size": "^2.0.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.5.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.5",
    "prisma": "^7.10.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "multer": "$multer"
  }
}
