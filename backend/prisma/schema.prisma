// Schema Prisma del progetto, ottenuto per introspezione del database
// PostgreSQL esistente (`prisma db pull`) e poi rifinito a mano.
//
// Convenzioni adottate rispetto allo schema grezzo prodotto
// dall'introspezione:
// - i modelli usano PascalCase singolare (User, ProductImage, ...) come da
//   convenzione Prisma, con @@map verso i nomi reali delle tabelle, che
//   restano invariati: nessuna migrazione di rinomina, solo un alias lato
//   codice;
// - i campi di relazione sono rinominati per conservare la semantica che
//   avevano in Sequelize e che è documentata in CLAUDE.md (`creator`,
//   `images`), invece dei nomi generati automaticamente (`users`,
//   `product_images`);
// - createdAt/updatedAt hanno @default(now()) e @updatedAt: Sequelize li
//   riempiva da solo con `timestamps: true`, Prisma no — senza queste
//   direttive ogni create dovrebbe passarli a mano.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(255)
  email         String    @unique @db.VarChar(255)
  password      String    @db.VarChar(255)
  current_token String?   @db.VarChar(500)
  level         UserLevel @default(admin)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  // Lato inverso della FK products.createdBy. In Sequelize questo lato non
  // esisteva (User non dichiarava alcun associate), ma Prisma richiede che
  // ogni relazione sia dichiarata su entrambi i lati: l'asimmetria
  // documentata in CLAUDE.md non è quindi rappresentabile, e da qui in poi
  // `user.products` è navigabile.
  products Product[]

  @@map("users")
}

model Customer {
  id            Int      @id @default(autoincrement())
  email         String   @unique @db.VarChar(255)
  password      String   @db.VarChar(255)
  current_token String?  @db.VarChar(500)
  firstName     String   @db.VarChar(255)
  lastName      String   @db.VarChar(255)
  address       String?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("customers")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  description String?
  price       Decimal  @db.Decimal(10, 2)
  quantity    Int      @default(0)
  available   Boolean  @default(true)
  sku         String?  @unique @db.VarChar(100)
  createdBy   Int
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  // `creator` conserva il nome dell'alias Sequelize (`as: 'creator'`).
  creator           User              @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  images            ProductImage[]
  productCategories ProductCategory[]

  @@index([name], map: "products_name")
  @@map("products")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(255)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  // NOTA: colonna presente ma NON gestita. In Sequelize `paranoid: true`
  // filtrava da solo le righe cancellate; Prisma non ha un equivalente
  // nativo e si è deciso di non introdurre infrastruttura di soft-delete
  // finché non esiste una funzionalità che cancella davvero (oggi nessun
  // controller/service cancella Category o ProductImage — verificato).
  // Attenzione quindi: `prisma.category.delete()` cancella FISICAMENTE la
  // riga, non valorizza questo campo. Vedi Design Decisions Log in
  // AGENTS.md prima di implementare la cancellazione.
  deletedAt DateTime? @db.Timestamptz(6)

  productCategories ProductCategory[]

  @@map("categories")
}

model ProductImage {
  id         Int      @id @default(autoincrement())
  product_id Int
  image_url  String   @db.VarChar(255)
  sort_order Int      @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  // Stessa nota di Category.deletedAt: colonna presente ma non gestita.
  deletedAt  DateTime? @db.Timestamptz(6)

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("product_images")
}

// Tabella ponte della relazione N:N fra Product e Category. Resta esplicita
// (non una relazione implicita di Prisma) perché ha campi propri
// (id, createdAt, updatedAt): il codice la naviga come
// product.productCategories[].category, non più come product.categories.
model ProductCategory {
  id          Int      @id @default(autoincrement())
  product_id  Int
  category_id Int
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  category Category @relation(fields: [category_id], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([product_id, category_id], map: "product_category_unique_idx")
  @@map("product_categories")
}

enum UserLevel {
  superadmin
  admin

  @@map("enum_users_level")
}
